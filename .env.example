# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env.
#
# Preferencia: OPENAI_API_KEY e ANTHROPIC_API_KEY como variaveis de ambiente
# do Windows (ja criadas). O Spring as le do ambiente; nao precisa repetir aqui.
# Este .env e especialmente para o docker compose (Postgres) e senha do datasource.

# Chaves de API — opcional se ja existirem no Windows
# ANTHROPIC_API_KEY=cole-sua-chave-anthropic-aqui
# OPENAI_API_KEY=cole-sua-chave-openai-aqui

# Profile Spring ativo
# Local: anthropic
# Cloud Run: anthropic,cloud
SPRING_PROFILES_ACTIVE=anthropic

# Postgres (docker-compose + Spring datasource)
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=altere-esta-senha
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5439/ragdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=altere-esta-senha

# Redis (memoria de conversa) — local Docker
SPRING_AI_CHAT_MEMORY_REDIS_HOST=localhost
SPRING_AI_CHAT_MEMORY_REDIS_PORT=6379

# Redis na nuvem (Redis Stack com TLS) — use URL OU host+senha+ssl
# SPRING_AI_CHAT_MEMORY_REDIS_URL=rediss://default:SENHA@SEU-HOST:6379
# SPRING_AI_CHAT_MEMORY_REDIS_HOST=
# SPRING_AI_CHAT_MEMORY_REDIS_PORT=6379
# SPRING_AI_CHAT_MEMORY_REDIS_USERNAME=default
# SPRING_AI_CHAT_MEMORY_REDIS_PASSWORD=
# SPRING_AI_CHAT_MEMORY_REDIS_SSL=true

# Neon (exemplo Cloud Run)
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Embeddings OpenAI (opcional — defaults no application-anthropic.yml)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SonarQube (opcional — nao commitar o token)
# SONAR_TOKEN=
