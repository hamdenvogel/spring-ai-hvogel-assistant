# Copie este arquivo para .env e preencha os valores.
# Nunca commite o arquivo .env.

# Chave da API Anthropic (obrigatoria para o profile anthropic)
ANTHROPIC_API_KEY=

# Profile Spring ativo
SPRING_PROFILES_ACTIVE=anthropic

# Postgres (docker-compose + Spring datasource)
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5439/ragdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis (memoria de conversa)
SPRING_AI_CHAT_MEMORY_REDIS_HOST=localhost
SPRING_AI_CHAT_MEMORY_REDIS_PORT=6379

# Ollama (embeddings)
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11435

# SonarQube (opcional — nao commitar o token)
# SONAR_TOKEN=
