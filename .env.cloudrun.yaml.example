# env-vars-file para gcloud run deploy (NAO commitado — veja .gitignore)
# Copie para .env.cloudrun.yaml, preencha e use:
#   gcloud run deploy ... --env-vars-file=.env.cloudrun.yaml
#
# Formato YAML chave: "valor"

SPRING_PROFILES_ACTIVE: "anthropic,cloud"

ANTHROPIC_API_KEY: "cole-anthropic"
OPENAI_API_KEY: "cole-openai"

SPRING_DATASOURCE_URL: "jdbc:postgresql://ep-xxxx.neon.tech/neondb?sslmode=require"
SPRING_DATASOURCE_USERNAME: "neondb_owner"
SPRING_DATASOURCE_PASSWORD: "cole-senha-neon"

# Preferir URL rediss:// (TLS) de um Redis Stack (Redis Cloud / similar)
SPRING_AI_CHAT_MEMORY_REDIS_URL: "rediss://default:SENHA@SEU-HOST:6379"
